# ============================================================
# TeamHub environment variables
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ============================================================

# --- Demo mode (optional) ---
# Force the app to run with seeded in-memory dummy data and no login.
# When not set, demo mode activates automatically when the Supabase
# credentials below are missing or the database is unreachable.
# Valid values: 1, true, yes
DEMO_MODE=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth ---
JWT_SECRET=

# --- Email (SMTP) ---
SMTP_EMAIL=
SMTP_PASSWORD=
SITE_URL=http://localhost:3000
